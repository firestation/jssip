# Скопируйте в .env и заполните. Файл .env в git не попадает.
# TURN/STUN, которые подставляются в index.html при сборке
TURN_URL_UDP=turn:HOST:3478?transport=udp
TURN_URL_TCP=turn:HOST:3478?transport=tcp
TURN_STUN=stun:HOST:3478
TURN_USER=
TURN_PASS=

# Деплой
HOST=your-server.example.com
KEY=~/.ssh/id_ed25519
APP_DIR=/var/www/jssip
