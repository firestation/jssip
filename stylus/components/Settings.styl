[data-component='Settings'] {
	height: 100%;
	width: 100%;
	padding: 20px;
	overflow: auto;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	background-color: rgba(#fff, 0.98);

	+desktop() {
		border-radius: 4px;
		box-shadow: 0px 0px 15px 0px rgba(#000, 0.9);
	}

	TransitionAppear(250ms);

	h1 {
		margin: 20px 0 10px 0;
		padding: 6px 16px;
		background-color: #ddd;

		&:first-child {
			margin-top: 0;
		}
	}

	.item {
		margin: 0 16px;

		.help {
			margin: 4px 0 10px 0;
			font-size: 12px;
			color: #888;
		}

		.buttons-row {
			display: flex;
			flex-direction: row;
			align-items: center;
			flex-wrap: wrap;
			margin-top: 10px;

			.ice-result {
				margin-left: 16px;
				font-size: 13px;
				color: #666;

				&.success {
					color: #2e7d32;
				}

				&.error {
					color: #c62828;
				}

				&.pending {
					color: #ef6c00;
				}
			}
		}

		.local-preview {
			display: block;
			width: 100%;
			max-width: 320px;
			max-height: 240px;
			margin-top: 10px;
			background-color: #000;
			border-radius: 4px;
		}
	}

	.separator {
		width: 100%;
		height: 20px;
	}

	> .buttons {
		flex: 0 0 auto;
		padding: 20px;
		display: flex;
		flex-direction: row;
		justify-content: space-around;
		align-items: center;
	}
}
