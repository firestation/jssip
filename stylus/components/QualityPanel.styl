[data-component='QualityPanel'] {
	position: fixed;
	z-index: 2000;
	right: 10px;
	bottom: 80px;
	min-width: 210px;
	padding: 8px 10px;
	border-radius: 6px;
	background-color: rgba(#000, 0.75);
	color: #fff;
	font-size: 12px;
	font-family: 'Roboto';

	> .header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 6px;
		font-weight: 500;

		> .actions {
			display: flex;
			flex-direction: row;
			align-items: center;
			gap: 10px;

			> .clear {
				cursor: pointer;
				font-size: 11px;
				opacity: 0.8;
				text-decoration: underline;

				&:hover {
					opacity: 1;
				}
			}

			> .close {
				cursor: pointer;
				padding: 0 2px;
				font-size: 16px;
				line-height: 1;
			}
		}
	}

	> .row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;

		> .label {
			opacity: 0.7;
			margin-right: 12px;
		}

		> .value {
			font-variant-numeric: tabular-nums;
		}
	}

	> .problem {
		color: #ff7b7b;
		margin-bottom: 4px;
	}
}
